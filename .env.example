# Relatório de travamentos (Sentry). Deixe vazio para manter desligado.
# Para ativar, veja as instruções em src/monitoring/crashReporting.ts.
VITE_SENTRY_DSN=

# Feature flags ligadas no servidor de desenvolvimento (npm run dev), separadas por vírgula
# (premium, ads, storeAchievements). O build de produção ignora esta variável: no jogo publicado,
# vale só o que está em src/config/featureFlags.ts.
VITE_FEATURE_FLAGS=
